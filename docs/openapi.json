          "label": {
            "type": "string",
            "title": "Label"
          },
          "start_s": {
            "type": "number",
            "title": "Start S"
          },
          "end_s": {
            "type": "number",
            "title": "End S"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "risk": {
            "type": "string",
            "title": "Risk"
          }
