        "type": "object",
        "required": [
          "student_a",
          "student_b",
          "similarity",
          "risk",
          "matches"
        ],
        "title": "TextPair"
      },
      "TextRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "submissions": {
            "items": {
              "$ref": "#/components/schemas/Submission"
