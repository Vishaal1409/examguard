        "properties": {
          "student_a": {
            "type": "string",
            "title": "Student A"
          },
          "student_b": {
            "type": "string",
            "title": "Student B"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity"
          },
          "risk": {
            "type": "string",
