        "properties": {
          "t": {
            "type": "integer",
            "title": "T"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "t",
          "label",
          "confidence"
