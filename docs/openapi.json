        "properties": {
          "session_id": {
            "type": "integer",
            "title": "Session Id"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "frames_analyzed": {
            "type": "integer",
            "title": "Frames Analyzed"
          },
